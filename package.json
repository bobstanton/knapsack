{
  "name": "knapsack",
  "version": "0.0.1",
  "description": "Editor, tester and note creator for Knap templates.",
  "main": "main.js",
  "scripts": {
    "lint": "eslint src package.json manifest.json versions.json",
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && npm run bundle",
    "typecheck": "tsc --noEmit --pretty false --skipLibCheck",
    "watch": "node esbuild.config.mjs watch",
    "bundle": "node esbuild.config.mjs production"
  },
  "keywords": [],
  "author": "Bob Stanton",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^2.1.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "1.14.4",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "knap": "0.6.0",
    "monkey-around": "^3.0.0"
  },
  "overrides": {
    "typescript": "6.0.3",
    "obsidian": "1.14.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15"
  }
}
